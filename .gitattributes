# ============================================================
#  .gitattributes — 统一行尾，避免跨平台 diff 噪音
# ============================================================

# 默认：自动识别文本，仓库内统一用 LF
* text=auto eol=lf

# ---------- 文本文件 ----------
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.svg       text eol=lf
*.py        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Windows 上给批处理保留 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ---------- 二进制 ----------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.npy       binary
*.ngmesh    binary

# ---------- 生成物：折叠 diff，标记为生成 ----------
# 这些文件由 tools/ 下的脚本生成，不要在 PR 里逐行看
assets/mcns-meshes.js  linguist-generated=true -diff
